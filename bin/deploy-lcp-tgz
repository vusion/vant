#!/usr/bin/env node

const vusion = require('vusion-api');
const fs = require('fs');
const argv = require('minimist')(process.argv.slice(2));
const pkg = require('../package.json');

const tgz = `lcap-mobile-ui-${pkg.version}.tgz`;

// tgz 是否存在
if (!fs.existsSync(tgz)) {
  vusion.cli.error(`${tgz} not found`);
  process.exit(1);
}

// zip.tgz 是否存在
if (fs.existsSync('zip.tgz')) {
  fs.unlinkSync('zip.tgz');
}

// 复制tgz到zip.tgz
fs.copyFileSync(tgz, 'zip.tgz');

let command = `lcap deploy zip.tgz`;

if (argv.platform) {
  command += ` --platform ${argv.platform}`;
}

if (argv.username) {
  command += ` --username ${argv.username}`;
}

if (argv.password) {
  command += ` --password ${argv.password}`;
}

console.log(command);
vusion.cli.execSync(command);
vusion.cli.done(`${tgz}`);
// 删除zip.tgz
fs.unlinkSync('zip.tgz');
